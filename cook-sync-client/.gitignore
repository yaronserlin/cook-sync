# Gradle caches and generated build outputs
.gradle/
build/
**/build/

# Local Android SDK path (machine-specific)
local.properties

# Android Studio / IntelliJ IDE project files
.idea/
*.iml
*.iws
*.ipr
.DS_Store

# Proguard-generated files
proguard/

# APK / AAB outputs
*.apk
*.aab

# Release signing key and credentials — never commit
keystore/
keystore.properties
*.jks

# Firebase project config — contains this project's API key; kept out of the (potentially
# public) repo. Each developer downloads their own from the Firebase console (Project settings >
# General > Your apps > google-services.json) and drops it in app/.
google-services.json
