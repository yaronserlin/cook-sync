<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_8"
    android:background="@drawable/bg_info_card"
    android:orientation="vertical"
    android:padding="@dimen/dp_14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_announcement_title"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_15"
            tools:text="Version update available" />

        <TextView
            android:id="@+id/tv_announcement_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@drawable/bg_pill_solid"
            android:paddingHorizontal="@dimen/dp_10"
            android:paddingVertical="@dimen/dp_3"
            android:textColor="@color/color_bg"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            tools:backgroundTint="@color/color_accent"
            tools:text="Info" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_announcement_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/color_text"
        android:alpha="0.75"
        android:textSize="@dimen/sp_13"
        tools:text="A new version fixes several bugs and improves performance across the app." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_announcement_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text"
            android:alpha="0.6"
            android:textSize="@dimen/sp_12"
            tools:text="Active" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_6"
            android:text="·"
            android:textColor="@color/color_text"
            android:alpha="0.6"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/tv_announcement_date"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/color_text"
            android:alpha="0.6"
            android:textSize="@dimen/sp_12"
            tools:text="3 days ago" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_deactivate_announcement"
            style="@style/CookSync.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp_0"
            android:minHeight="@dimen/dp_0"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:paddingHorizontal="@dimen/dp_10"
            android:text="@string/admin_announcements_deactivate"
            android:textColor="@color/color_danger"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>

</LinearLayout>
