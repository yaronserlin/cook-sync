<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:background="@drawable/bg_info_card"
        android:orientation="vertical"
        android:padding="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/admin_app_config_title"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_15" />

            <TextView
                android:id="@+id/tv_current_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_11"
                tools:text="This build: v1" />

        </LinearLayout>

        <EditText
            android:id="@+id/et_min_version_code"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/bg_input"
            android:hint="@string/admin_app_config_min_version_hint"
            android:inputType="number"
            android:paddingHorizontal="@dimen/dp_12"
            android:textSize="@dimen/sp_14" />

        <EditText
            android:id="@+id/et_download_url"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_input"
            android:hint="@string/admin_app_config_download_url_hint"
            android:inputType="textUri"
            android:paddingHorizontal="@dimen/dp_12"
            android:textSize="@dimen/sp_14" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_app_config"
            style="@style/CookSync.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/admin_app_config_save" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@drawable/bg_info_card"
        android:orientation="vertical"
        android:padding="@dimen/dp_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/admin_announcements_compose_title"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_15" />

        <EditText
            android:id="@+id/et_announcement_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/bg_input"
            android:hint="@string/admin_announcements_title_hint"
            android:inputType="text"
            android:paddingHorizontal="@dimen/dp_12"
            android:textSize="@dimen/sp_14" />

        <EditText
            android:id="@+id/et_announcement_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_input_multiline"
            android:gravity="top|start"
            android:hint="@string/admin_announcements_body_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:textSize="@dimen/sp_14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:alpha="0.6"
            android:text="@string/admin_announcements_severity_label"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_12" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_6"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/dp_14"
            app:cardElevation="@dimen/dp_0"
            app:strokeColor="@color/color_divider"
            app:strokeWidth="@dimen/dp_1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_severity_info"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_18"
                    android:text="@string/admin_announcements_severity_info"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_severity_action_required"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_18"
                    android:text="@string/admin_announcements_severity_action_required"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_announcement"
            style="@style/CookSync.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/admin_announcements_send" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/dp_24"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_announcements"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dp_16"
        tools:listitem="@layout/item_admin_announcement" />

</LinearLayout>
