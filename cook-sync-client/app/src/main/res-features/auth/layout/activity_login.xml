<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_bg">

    <include
        android:id="@+id/skeleton_container"
        layout="@layout/activity_login_skeleton"
        android:visibility="visible" />

    <ScrollView
        android:id="@+id/form_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_28"
            android:paddingEnd="@dimen/dp_28"
            android:paddingTop="@dimen/dp_64"
            android:paddingBottom="@dimen/dp_32">

            <TextView
                android:id="@+id/tv_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/sp_38"
                android:fontFamily="@font/caprasimo"
                android:textColor="@color/color_accent"
                android:layout_marginBottom="@dimen/dp_32" />

            <TextView
                android:id="@+id/tv_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="@dimen/sp_26"
                android:fontFamily="@font/caprasimo"
                android:textColor="@color/color_text"
                android:lineSpacingExtra="@dimen/dp_2"
                android:layout_marginBottom="@dimen/dp_8" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text"
                android:alpha="0.65"
                android:lineSpacingExtra="@dimen/dp_3"
                android:layout_marginBottom="@dimen/dp_36" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                style="@style/CookSync.FieldLabel" />

            <EditText
                android:id="@+id/et_email"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:maxLength="255"
                android:autofillHints="emailAddress"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_email_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_password"
                style="@style/CookSync.FieldLabel" />

            <com.cooksync.app.ui.common.PasswordEditText
                android:id="@+id/et_password"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                android:imeOptions="actionDone"
                android:maxLength="100"
                android:autofillHints="password"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_password_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/dp_20"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/dp_4"
                android:text="@string/action_forgot_password"
                android:textColor="@color/color_accent"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_in"
                style="@style/CookSync.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_sign_in"
                android:layout_marginBottom="@dimen/dp_12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_account"
                style="@style/CookSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_create_account"
                android:layout_marginBottom="@dimen/dp_24" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/color_accent"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/dp_16" />

            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_privacy"
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text"
                android:alpha="0.45"
                android:layout_gravity="center_horizontal"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
