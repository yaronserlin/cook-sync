<?xml version="1.0" encoding="utf-8"?>
<!--
  Darker, fully-rounded skeleton bone for primary button-sized placeholders (see
  activity_login_skeleton.xml, activity_register_skeleton.xml), so a screen's primary
  call-to-action visually stands out from the plain text-line and input bones drawn with
  @drawable/bg_skeleton_bone even while content is still loading.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_neutral_800" />
    <corners android:radius="999dp" />
</shape>
