<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required at runtime (not just declared here) on Android 13+ to actually show a
         notification — requested from HomeActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CookSyncApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.CookSync"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.VerifyOtpActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipe.detail.RecipeDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipe.cooking.CookingModeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipe.review.ReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.UserProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipe.myrecipes.MyRecipesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipe.favorites.FavoriteRecipesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.recipe.wizard.AddRecipeWizardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.recipe.search.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.AccountDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.CookingPreferencesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.NotificationPreferencesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.LegalDocumentActivity"
            android:exported="false" />

        <activity
            android:name=".ui.common.FullscreenImageActivity"
            android:exported="false" />

        <activity
            android:name=".ui.common.ForceUpdateActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminConsoleActivity"
            android:exported="false" />

        <service
            android:name=".data.service.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Channel FCM auto-displays into when it shows a notification itself (app not in the
             foreground) — must match the channel PushMessagingService registers/uses. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_general_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_bell" />

    </application>

</manifest>
