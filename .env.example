# Copy to .env and fill in real values, then run: docker compose up --build
#
# This file is for Docker Compose only. It's separate from cook-sync-server/.env,
# which is used when running the server directly via ./mvnw spring-boot:run.

# --- Database (MySQL container) ---
# The Docker setup always connects as the "root" MySQL user (see docker-compose.yml);
# only the password and database name are configurable here.
DB_PASSWORD=root
MYSQL_DATABASE=cooksync_db

# --- Server ---
# Host port the API is published on (the container always listens on 8080 internally).
PORT=8080

# Required — must be Base64 (JwtUtil Base64-decodes it before using it as the HMAC-SHA256
# signing key, which needs >= 256 bits). Leaving it blank does NOT fail at startup — the
# app boots fine and only throws (WeakKeyException) the first time it tries to sign a
# token, e.g. on login. Generate one with: openssl rand -base64 32
JWT_SECRET=

# --- Outgoing mail (optional) ---
# Leave MAIL_USERNAME/MAIL_PASSWORD blank to run without sending real emails
# (OTP codes are logged instead of emailed).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Cloudinary media storage ---
# Required — the app refuses to start without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
