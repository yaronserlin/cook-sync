# Copy to .env and fill in real values, then run: docker compose up --build
#
# This file is for Docker Compose only. It's separate from cook-sync-server/.env,
# which is used when running the server directly via ./mvnw spring-boot:run.

# The Docker setup always connects as the "root" MySQL user (see docker-compose.yml);
# only the password and database name are configurable here.
DB_PASSWORD=root
MYSQL_DATABASE=cooksync_db

# Host port the API is published on (the container always listens on 8080 internally).
PORT=8080

# Required — must be Base64 (JwtUtil Base64-decodes it before using it as the HMAC-SHA256
# signing key, which needs >= 256 bits). Leaving it blank does NOT fail at startup — the
# app boots fine and only throws (WeakKeyException) the first time it tries to sign a
# token, e.g. on login. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional — how long a refresh token stays valid, in milliseconds. Defaults to 604800000
# (7 days) if unset. Each successful refresh rotates the token, so this is really the
# "how long can a device stay logged out before needing to sign in again" window.

# Leave these blank to run without sending real emails (OTP codes are logged instead of
# emailed). All three are required together to send via the Gmail API as the developer's
# own Gmail account - see cook-sync-server/README.md's Configuration table for how to
# obtain them (a one-time Google Cloud Console OAuth setup).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional at startup — the app boots fine without these (CloudinaryConfig defaults every
# value to blank). Required in practice for image uploads (recipe/avatar photos) to work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
