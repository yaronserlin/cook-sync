<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Dims only DEBUG/TRACE message text; every other level's message stays regular/uncolored. -->
    <conversionRule conversionWord="debugFaint" class="com.cooksync_server.config.FaintDebugMessageConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- NOTE: the space before %n is required — Logback mis-parses %n as literal text
                 when it immediately follows a composite converter's closing paren with no
                 separating character (reproducible with any %xxx(...)%n, not specific to
                 debugFaint); the trailing space itself is invisible in terminal output. -->
            <pattern>%clr([%d{yyyy-MM-dd HH:mm:ss}]){faint} %clr([%-5level]) %clr([%15.15thread]){faint} %clr([%-36.36logger{0}]){cyan} %clr(:){faint} %debugFaint(%msg) %n%wEx</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
